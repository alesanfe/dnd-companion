# Convención del repo: espacios en Python (4) y en JS/JSX (2).
# Los editores con soporte EditorConfig lo aplican solos.
root = true

[*.py]
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,css,html}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{md,toml,json}]
indent_style = space
insert_final_newline = true
